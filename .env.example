# 复制本文件为 .env 并按需修改（启动时自动加载；系统环境变量优先于 .env）

# DeepSeek API Key（ask 问答必需）
deepseek_api=sk-粘贴你的密钥

# 嵌入模型（中文语料默认 bge-base-zh-v1.5；英文语料请改 bge-base-en-v1.5）
BGE_EMBED_MODEL=bge-base-zh-v1.5

# 以下路径默认全部解析到项目内目录，一般无需修改；如需自定义再取消注释
# MINERU_OUT=你的目录\mineru输出\batch
# DOCS_DIR=你的目录\docx文档
# MODELSCOPE_CACHE=你的目录\models
# RAG_KB_FILE=你的目录\knowledge_base.json
# RAG_VECTOR_DB=你的目录\vector_db
# RAG_OBS_LOG=你的目录\observability.jsonl

# 引用点击翻页的链接基地址（配合 DSH 插件使用，端口按实际 DSH 修改）
# RAG_LINK_BASE=http://127.0.0.1:3080/dsh-rag/open

# 桌面端启动 DeepSeek Harness 的命令（默认直接用 PATH 里的 dsh）
# DSH_CMD=你的目录\dsh.cmd

# 综述工作台 / 文档元数据侧车 / 编辑器地址（默认解析到知识库同目录与 8000 端口）
# RAG_SURVEY_DIR=你的目录\surveys
# RAG_DOC_META=你的目录\doc_metadata.json
# RAG_EDITOR_BASE=http://127.0.0.1:8000/editor
